# GEMINI_API_KEY: Required for Gemini AI document extraction & intelligence.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# PORT: Server port (defaults to 3000)
PORT="3000"

# JWT_SECRET: Secret key used to sign authentication tokens.
JWT_SECRET="replace-with-strong-random-secret-in-production"

# DATABASE_PATH: SQLite database file path (optional, defaults to ./landtrace.db)
DATABASE_PATH="./landtrace.db"

# CORS_ORIGIN: Allowed origin for CORS in production (optional)
CORS_ORIGIN="*"
